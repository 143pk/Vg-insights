rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Prevent unauthorized users from modifying premium status through client-side state or direct database writes
      allow create: if request.auth != null && request.auth.uid == userId
        && (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false)
        && (!('premiumExpiresAt' in request.resource.data) || request.resource.data.premiumExpiresAt == null);
      allow update: if request.auth != null && request.auth.uid == userId
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium', 'premiumExpiresAt', 'planId', 'entitlement', 'subscriptionId']));
      
      match /payments/{paymentId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /testHistory/{historyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /bookmarks/{bookmarkId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /chapterwiseProgress/{chapterId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /chapterwise_mcqs/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /test/connection {
      allow read: if true;
    }
  }
}
