{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with NEET target year, preferences, and verified premium entitlements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "targetYear": { "type": "number" },
        "photoURL": { "type": "string" },
        "isPremium": { "type": "boolean" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "subscriptionId": { "type": "string" },
        "premiumStatus": { "type": "string", "enum": ["active", "cancelled", "halted", "expired", "free"] },
        "premiumExpiresAt": { "type": "number" },
        "lastPaymentId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "name"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Cryptographically verified server payment record",
      "type": "object",
      "properties": {
        "paymentId": { "type": "string" },
        "orderId": { "type": "string" },
        "subscriptionId": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "amountInPaise": { "type": "number" },
        "amountInInr": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string", "enum": ["created", "authorized", "captured", "failed", "refunded"] },
        "verifiedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["paymentId", "planId", "status"]
    },
    "SubscriptionRecord": {
      "title": "SubscriptionRecord",
      "description": "Server-tracked Razorpay recurring subscription state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "status": { "type": "string", "enum": ["created", "authenticated", "active", "pending", "halted", "cancelled", "completed", "expired"] },
        "billingType": { "type": "string" },
        "activatedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "lastPaymentId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "planId", "status"]
    },
    "WebhookEvent": {
      "title": "WebhookEvent",
      "description": "Idempotency audit log for signed Razorpay webhooks",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "event": { "type": "string" },
        "processedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventId", "event", "processedAt"]
    },
    "UserTestHistory": {
      "title": "UserTestHistory",
      "description": "Test attempt records for a student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "testTitle": { "type": "string" },
        "subject": { "type": "string" },
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "accuracy": { "type": "number" },
        "correctCount": { "type": "number" },
        "incorrectCount": { "type": "number" },
        "unattemptedCount": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "score"]
    },
    "ChapterwiseMCQ": {
      "title": "ChapterwiseMCQ",
      "description": "NCERT-aligned NEET UG chapter-wise multiple choice questions with complete 6-part solutions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "questionNumber": { "type": "number" },
        "question": { "type": "string" },
        "options": {
          "type": "object",
          "properties": {
            "A": { "type": "string" },
            "B": { "type": "string" },
            "C": { "type": "string" },
            "D": { "type": "string" }
          }
        },
        "correctAnswer": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "explanation": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "subject": { "type": "string" },
        "class": { "type": "string" },
        "chapter": { "type": "string" },
        "chapterId": { "type": "string" },
        "topic": { "type": "string" },
        "source": { "type": "string" },
        "isPYQ": { "type": "boolean" },
        "pyqYear": { "type": "number" }
      },
      "required": ["question", "options", "correctAnswer", "explanation", "difficulty", "subject", "chapter", "source", "isPYQ"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores student user profiles with verified premium status"
    },
    "/users/{userId}/payments/{paymentId}": {
      "schema": "PaymentRecord",
      "description": "Cryptographically verified server payment records"
    },
    "/users/{userId}/subscriptions/{subscriptionId}": {
      "schema": "SubscriptionRecord",
      "description": "Server-controlled Razorpay recurring subscription state"
    },
    "/webhookEvents/{eventId}": {
      "schema": "WebhookEvent",
      "description": "Idempotency log of verified Razorpay webhook events"
    },
    "/users/{userId}/testHistory/{historyId}": {
      "schema": "UserTestHistory",
      "description": "Student test history records"
    },
    "/chapterwise_mcqs/{chapterId}/questions/{questionId}": {
      "schema": "ChapterwiseMCQ",
      "description": "Verified chapterwise multiple choice questions"
    }
  }
}
