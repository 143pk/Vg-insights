# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GMAIL SMTP CONFIGURATION (Server-side environment variables only)
# Never expose these in frontend code or client bundles.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-16-character-google-app-password"

# RAZORPAY PAYMENT GATEWAY (Server-side environment variables only)
# Never expose RAZORPAY_KEY_SECRET in frontend bundles or client code.
# Get these credentials from your Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
RAZORPAY_MONTHLY_PLAN_ID="plan_your_monthly_plan_id" # Optional: Auto-created if omitted (₹199/month, 1 cycle interval)

# META PIXEL CONFIGURATION (Facebook Pixel)
# Enter your 15-16 digit Meta Pixel ID / Dataset ID from Meta Events Manager.
VITE_META_PIXEL_ID="915584438158901"

# Optional: Firebase Cloud Functions direct URL (if frontend calls standalone Cloud Functions directly)
# Example: https://us-central1-vginsights-bed28.cloudfunctions.net
VITE_FIREBASE_FUNCTIONS_URL=""

# FIREBASE SECRET MANAGER SETUP COMMANDS:
# 1. Set Razorpay credentials in Firebase Secret Manager:
#    firebase functions:secrets:set RAZORPAY_KEY_ID
#    firebase functions:secrets:set RAZORPAY_KEY_SECRET
#    firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET
#    firebase functions:secrets:set RAZORPAY_MONTHLY_PLAN_ID
#
# 2. Deploy Cloud Functions:
#    firebase deploy --only functions
#
# 3. Deploy Firestore Security Rules:
#    firebase deploy --only firestore:rules
#
# 4. Razorpay Webhook Configuration:
#    URL: https://<region>-<project-id>.cloudfunctions.net/razorpayWebhook OR https://vginsights.in/api/payment/webhook
#    Secret: value configured in RAZORPAY_WEBHOOK_SECRET
#    Active Events to subscribe:
#      - subscription.activated
#      - subscription.charged
#      - subscription.halted
#      - subscription.cancelled
#      - payment.failed
